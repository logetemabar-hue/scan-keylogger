DISCORD_BOT_TOKEN=
# Optional. The bot now resolves this automatically from DISCORD_BOT_TOKEN.
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SCAN_ENABLED=true
MAX_FILE_BYTES=2000000
# Use a Railway Volume mounted at /data for persistence across redeploys.
SCAN_CONFIG_PATH=/data/scan-channels.json